# Copy this file to .env, fill locally and restart npm run dev.
# Alternatively use the application's Bağlantılar form.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=hello@hiwellapp.com
SENDGRID_FROM_NAME=Hiwell

# Optional: use the Google Chrome installed in Applications.
# IG_BROWSER_CHANNEL=chrome
# Shared HTTPS office access: npm run lan:setup, then npm run lan.
# Network address and certificates are stored under .local; do not share private keys.

# Optional paid fallback. Off by default; one HTML and at most one search request per unreadable profile.
SCRAPINGBEE_API_KEY=
TIKTOK_SCRAPINGBEE_ENABLED=false
TIKTOK_GOOGLE_ENABLED=false

# Optional Instagram headless scanning; login button still opens a visible browser.
IG_HEADLESS=false
# Instagram: stop waiting when data is ready and skip profile images/video.
IG_FAST_SCAN=true
